# Copy this file to .env and fill in ONE source. .env is ignored by git, never upload it.

# IGDB (recommended): free, from https://dev.twitch.tv/console > Register Your Application
IGDB_CLIENT_ID=paste-your-client-id
IGDB_CLIENT_SECRET=paste-your-client-secret

# RAWG (alternative): free, from https://rawg.io/apidocs
RAWG_API_KEY=paste-your-key-here
